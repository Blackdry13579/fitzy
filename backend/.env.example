PORT=4000
# Database connection string (server-side only, never expose to frontend)
DATABASE_URL=
# JWT secret (set a strong random value in production)
JWT_SECRET=change_me
# Public frontend/app base URL used for referral links
APP_BASE_URL=https://fitzone.app
# Comma-separated allowed CORS origins (leave empty to allow all)
CORS_ORIGINS=
# Admin bootstrap credentials (optional overrides)
# ADMIN_PHONE=02040608
# ADMIN_PASSWORD=change_me
# ADMIN_EMAIL=
